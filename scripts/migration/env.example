# ─────────────────────────────────────────────────────────────────────────────
# Credenciais da migração Lovable Cloud → Supabase próprio.
#
# Copie para `.env.migration` NA RAIZ do repo (já coberto pelo .gitignore
# via `.env.*`) e preencha. NUNCA comite este arquivo preenchido, nunca cole
# estes valores em chat, ticket ou log.
#
# Uso:  node --env-file=.env.migration scripts/migration/00-preflight.mjs
# ─────────────────────────────────────────────────────────────────────────────

# ORIGEM — projeto gerenciado pelo Lovable Cloud
ORIGIN_SUPABASE_URL=https://vkriobpmolgopbbpqeky.supabase.co
ORIGIN_SERVICE_KEY=

# DESTINO — projeto novo, na org da Origami
TARGET_SUPABASE_URL=https://SEU_REF_NOVO.supabase.co
TARGET_SERVICE_KEY=

# CLI — Personal Access Token (https://supabase.com/dashboard/account/tokens)
# Necessário para os comandos `supabase …` rodarem fora de terminal interativo.
SUPABASE_ACCESS_TOKEN=

# Plano B do Storage, quando não se consegue a service key da origem:
# o script loga como este admin e copia o que a RLS permitir.
ORIGIN_ADMIN_EMAIL=
ORIGIN_ADMIN_PASSWORD=
