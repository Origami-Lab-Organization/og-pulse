# Fila. A service key bypassa RLS: este processo escreve resultado em nome de ninguém.
# Ela é a credencial mais sensível aqui — 0600, nunca em repositório.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Modelo. large-v3 é o melhor em português; medium roda em máquina modesta com perda real.
WHISPER_MODEL=large-v3

# Vazio = detecta sozinho (cuda se houver GPU, senão cpu).
WHISPER_DEVICE=
# Vazio = float16 em GPU, int8 em CPU. int8_float16 é meio-termo em GPU pequena.
WHISPER_COMPUTE_TYPE=
# Em CPU, batch alto não ajuda e come memória.
BATCH_SIZE=8

# Separação de vozes (pyannote). SEM ISTO A TRANSCRIÇÃO SAI SEM "quem falou".
# Conta grátis no Hugging Face + aceite dos termos dos modelos — ver README.
HF_TOKEN=

POLL_INTERVAL_SECONDS=30
MAX_ATTEMPTS=3
# Aparece em claimed_by, para achar job preso sem entrar na VM.
WORKER_NAME=
LOG_LEVEL=INFO
