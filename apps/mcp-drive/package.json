{
  "name": "@og-pulse/mcp-drive",
  "version": "1.0.0",
  "description": "MCP server para subir arquivos na pasta do projeto no OneDrive, conversacionalmente",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/og-pulse-mcp-drive.mjs --banner:js='import{createRequire as __cr}from\"node:module\";const require=__cr(import.meta.url);'",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@supabase/supabase-js": "^2.49.4",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
