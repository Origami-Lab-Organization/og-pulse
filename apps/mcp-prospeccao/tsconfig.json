{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    // Reaproveita as regras puras da Prospecção (etapas, motivos, métricas) direto de
    // `src/`, em vez de copiá-las — é o que evita repetir o TD-0022. O esbuild resolve o
    // alias ao empacotar; só módulos SEM dependência de browser podem ser importados.
    "paths": {
      "@/*": ["../../src/*"]
    },
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
