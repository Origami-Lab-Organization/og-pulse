{
  "installCommand": "npm install",
  "buildCommand": "bash scripts/vercel-build.sh",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "og-pulse.vercel.app" }],
      "destination": "https://origamipulse.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/app.html" }
  ]
}
